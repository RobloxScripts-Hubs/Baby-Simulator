local function logConsole(msg)
	local label = Instance.new("TextLabel")
	label.Size = UDim2.new(1, -10, 0, 18)
	label.BackgroundTransparency = 1
	label.Text = " > " .. msg
	label.TextColor3 = THEME.TextPrimary
	label.Font = Enum.Font.Code
	label.TextSize = 11
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.Parent = consoleBox
	consoleBox.CanvasSize = UDim2.new(0, 0, 0, consoleList.AbsoluteContentSize.Y + 10)
end

local function executeCommand(cmdStr)
	if cmdStr == "" then return end
	logConsole(cmdStr)
	local args = string.split(cmdStr, " ")
	local cmd = string.lower(args[1] or "")
	local val = tonumber(args[2])
	local char = player.Character
	local hum = char and char:FindFirstChild("Humanoid")

	if cmd == "ws" or cmd == "walkspeed" then
		if hum and val then hum.WalkSpeed = val logConsole("WalkSpeed set to " .. val) end
	elseif cmd == "jp" or cmd == "jumppower" then
		if hum and val then hum.UseJumpPower = true hum.JumpPower = val logConsole("JumpPower set to " .. val) end
	elseif cmd == "sit" then
		if hum then hum.Sit = true logConsole("Character sitting.") end
	elseif cmd == "clear" then
		for _, child in ipairs(consoleBox:GetChildren()) do
			if child:IsA("TextLabel") then child:Destroy() end
		end
	else
		logConsole("Unknown command: " .. cmd)
	end
end

runBtn.MouseButton1Click:Connect(function() executeCommand(cmdBox.Text) cmdBox.Text = "" end)
