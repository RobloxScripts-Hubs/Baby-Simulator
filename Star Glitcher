-- 5. HAT PHYSICS & FORMATIONS ENGINE
--------------------------------------------------------------------------------
local renderConnection = nil
local currentModeName = "None"
local hatPositions = {}
local MAX_SPEED = 100
local LERP_FACTOR = 0.18

local function getHatHandles()
	local character = player.Character or player.CharacterAdded:Wait()
	local handles = {}
	for _, accessory in ipairs(character:GetChildren()) do
		if accessory:IsA("Accessory") then
			local handle = accessory:FindFirstChild("Handle")
			if handle then
				table.insert(handles, handle)
			end
		end
	end
	return handles
end

local function prepareHandles(handles)
	for _, handle in ipairs(handles) do
		handle.Anchored = false
		for _, v in ipairs(handle:GetChildren()) do
			if v:IsA("Weld") or v:IsA("WeldConstraint") or v:IsA("Motor6D") then
				v.Enabled = false
			end
		end
	end
end

local function stopFormation()
	if renderConnection then
		renderConnection:Disconnect()
		renderConnection = nil
	end
	hatPositions = {}
end

local function resetHats()
	stopFormation()
	currentModeName = "None"
	for _, handle in ipairs(getHatHandles()) do
		for _, v in ipairs(handle:GetChildren()) do
			if v:IsA("Weld") or v:IsA("WeldConstraint") or v:IsA("Motor6D") then
				v.Enabled = true
			end
		end
	end
end

local function updateHatPhysics(handle, targetCFrame, dt, index)
	if not hatPositions[index] then
		hatPositions[index] = handle.CFrame.Position
	end
	local currentPos = hatPositions[index]
	local targetPos = targetCFrame.Position
	local interpolatedPos = currentPos:Lerp(targetPos, math.clamp(dt * (LERP_FACTOR * 60), 0, 1))
	local delta = interpolatedPos - currentPos
	local distance = delta.Magnitude
	local maxDistanceThisFrame = MAX_SPEED * dt
	if distance > maxDistanceThisFrame and distance > 0 then
		interpolatedPos = currentPos + (delta.Unit * maxDistanceThisFrame)
	end
	hatPositions[index] = interpolatedPos
	handle.CFrame = CFrame.new(interpolatedPos) * targetCFrame.Rotation
end

