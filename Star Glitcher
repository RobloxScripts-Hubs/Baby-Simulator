		currentModeName = name
		local handles = getHatHandles()
		prepareHandles(handles)
		local timer = 0
		renderConnection = RunService.RenderStepped:Connect(function(dt)
			local char = player.Character
			if not char or not char:FindFirstChild("HumanoidRootPart") then return end
			local root = char.HumanoidRootPart
			local count = #handles
			if count == 0 then return end
			timer = timer + dt
			callback(handles, root, count, timer, dt)
		end)
	end)
end

local f = {}
f["Back Sphere"] = function(h, r, c, t, dt)
	local center = r.CFrame * CFrame.new(0, 1, 3.5)
	for i, handle in ipairs(h) do
		local phi = math.acos(1 - 2 * (i - 0.5) / c)
		local theta = math.pi * (1 + 5^0.5) * i + (t * 2.5)
		local rad = 3.5
		local target = center * CFrame.new(rad * math.sin(phi) * math.cos(theta), rad * math.sin(phi) * math.sin(theta), rad * math.cos(phi))
		updateHatPhysics(handle, target, dt, i)
	end
end

f["Back Ring"] = function(h, r, c, t, dt)
	local center = r.CFrame * CFrame.new(0, 1.2, 3)
	for i, handle in ipairs(h) do
		local ang = (t * 3.5) + ((i / c) * math.pi * 2)
		local target = center * CFrame.new(math.cos(ang) * 4, math.sin(ang) * 4, 0) * CFrame.Angles(0, 0, ang)
		updateHatPhysics(handle, target, dt, i)
	end
end

f["Head Sweep"] = function(h, r, c, t, dt)
	local center = r.CFrame * CFrame.new(0, 3.5, 0)
	for i, handle in ipairs(h) do
		local offset = ((i - (c / 2)) * 1.2)
		local sweep = math.sin(t * 4 + i) * 1.5
		local target = center * CFrame.new(offset, 0, sweep)
		updateHatPhysics(handle, target, dt, i)
	end
end

f["Hip Orbit"] = function(h, r, c, t, dt)
	local center = r.CFrame * CFrame.new(0, -1, 0)
	for i, handle in ipairs(h) do
		local ang = (t * 4) + ((i / c) * math.pi * 2)
		local target = center * CFrame.new(math.cos(ang) * 3, 0, math.sin(ang) * 3)
		updateHatPhysics(handle, target, dt, i)
	end
end

f["Head Halo"] = function(h, r, c, t, dt)
	local center = r.CFrame * CFrame.new(0, 4, 0)
	for i, handle in ipairs(h) do
		local ang = (t * 3) + ((i / c) * math.pi * 2)
		local target = center * CFrame.new(math.cos(ang) * 2.5, math.sin(t * 2 + i) * 0.3, math.sin(ang) * 2.5)
		updateHatPhysics(handle, target, dt, i)
	end
end

f["Wing Spread"] = function(h, r, c, t, dt)
	local center = r.CFrame * CFrame.new(0, 1.5, 2)
	for i, handle in ipairs(h) do
		local side = (i % 2 == 0) and 1 or -1
		local idx = math.ceil(i / 2)
		local flap = math.sin(t * 3) * 0.4
		local target = center * CFrame.new(side * (idx * 1.2), (idx * 0.7) + flap, idx * 0.2)
		updateHatPhysics(handle, target, dt, i)
	end
end

for idx = 7, 50 do
	local name = "Formation #" .. idx
	f[name] = function(h, r, c, t, dt)
		for i, handle in ipairs(h) do
			local ang = (t * (2 + (idx % 4))) + ((i / c) * math.pi * 2)
			local rad = 2 + (idx % 3)
			local y = math.sin(t * 3 + (i * idx)) * 1.5
			local target = r.CFrame * CFrame.new(math.cos(ang) * rad, y, math.sin(ang) * rad)
			updateHatPhysics(handle, target, dt, i)
		end
	end
end

for name, cb in pairs(f) do addFormationButton(name, cb) end

