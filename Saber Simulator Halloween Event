-- HALLOWEEN BOSS LOGIC
----------------------------------------------------
local originalPos = nil
local teleportedToBoss = false
local bossTargetPos = Vector3.new(799, 236, 1237)

local function setBossState(enabled)
	autoTpEnabled = enabled
	valBoss.Value = enabled
	
	if autoTpEnabled then
		bossToggleBtn.Text = "ON"
		bossToggleBtn.BackgroundColor3 = ORANGE_THEME
		bossToggleBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
	else
		bossToggleBtn.Text = "OFF"
		bossToggleBtn.BackgroundColor3 = Color3.fromRGB(45, 45, 55)
		bossToggleBtn.TextColor3 = Color3.fromRGB(180, 180, 180)
		
		if teleportedToBoss and originalPos and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
			LocalPlayer.Character.HumanoidRootPart.CFrame = originalPos
			teleportedToBoss = false
			originalPos = nil
		end
	end
end

bossToggleBtn.MouseButton1Click:Connect(function()
	setBossState(not autoTpEnabled)
end)

valBoss.Changed:Connect(function(val)
	if val ~= autoTpEnabled then
		setBossState(val)
	end
end)

task.spawn(function()
	while screenGui.Parent do
		task.wait(0.5)
		
		if autoTpEnabled then
			local char = LocalPlayer.Character
			local hrp = char and char:FindFirstChild("HumanoidRootPart")
			
			local gameplay = workspace:FindFirstChild("Gameplay")
			local regions = gameplay and gameplay:FindFirstChild("RegionsLoaded")
			local eventFolder = regions and regions:FindFirstChild("HalloweenEvent")
			local bossFolder = eventFolder and eventFolder:FindFirstChild("Boss")
			local bossHolder = bossFolder and bossFolder:FindFirstChild("BossHolder")
			
			local hasBoss = bossHolder and (#bossHolder:GetChildren() > 0)
			
			if hrp then
				if hasBoss and not teleportedToBoss then
					originalPos = hrp.CFrame
					hrp.CFrame = CFrame.new(bossTargetPos)
					teleportedToBoss = true
				elseif not hasBoss and teleportedToBoss then
					if originalPos then
						hrp.CFrame = originalPos
					end
					teleportedToBoss = false
					originalPos = nil
				end
			end
		end
	end
end)

