local LocalPlayer = Players.LocalPlayer
local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")

-- Clean up ALL pre-existing GUI copies safely
for _, gui in ipairs(PlayerGui:GetChildren()) do
	if gui.Name == "SSHS" then
		-- Untoggle features on this old copy first
		local oldState = gui:FindFirstChild("StateValues")
		if oldState then
			for _, val in ipairs(oldState:GetChildren()) do
				if val:IsA("BoolValue") then
					val.Value = false
				end
			end
		end
		
		-- Destroy after a brief 0.25s grace period
		task.spawn(function()
			task.wait(0.25)
			if gui and gui.Parent then
				gui:Destroy()
			end
		end)
	end
end

