end

lollipopToggleBtn.MouseButton1Click:Connect(function()
	setLollipopState(not autoLollipopEnabled)
end)

valLoli.Changed:Connect(function(val)
	if val ~= autoLollipopEnabled then
		setLollipopState(val)
	end
end)

local function getItemCFrame(item)
	if item:IsA("BasePart") then
		return item.CFrame
	elseif item:IsA("Model") then
		if item.PrimaryPart then
			return item.PrimaryPart.CFrame
		else
			return item:GetPivot()
		end
	end
	return nil
end

task.spawn(function()
	while screenGui.Parent do
		task.wait(0.05)
		
		if autoLollipopEnabled then
			local char = LocalPlayer.Character
			local hrp = char and char:FindFirstChild("HumanoidRootPart")
			
			local gameplay = workspace:FindFirstChild("Gameplay")
			local regions = gameplay and gameplay:FindFirstChild("RegionsLoaded")
			local eventFolder = regions and regions:FindFirstChild("HalloweenEvent")
			local currencyPickup = eventFolder and eventFolder:FindFirstChild("CurrencyPickup")
			local currencyHolder = currencyPickup and currencyPickup:FindFirstChild("CurrencyHolder")
			
			if hrp and currencyHolder then
				local lollipops = currencyHolder:GetChildren()
				
				for _, item in ipairs(lollipops) do
					if not autoLollipopEnabled then break end
					
					local itemCFrame = getItemCFrame(item)
					if itemCFrame then
						hrp.CFrame = itemCFrame
						task.wait(0.1)
					end
				end
			end
		end
	end
end)

