--------------------------------------------------------------------------------
-- NAVIGATION TABS SYSTEM
--------------------------------------------------------------------------------
local Tabs = {}

local function createTabFrame(name)
	local frame = Instance.new("Frame")
	frame.Name = name .. "Tab"
	frame.Size = UDim2.new(1, 0, 1, 0)
	frame.BackgroundTransparency = 1
	frame.Visible = false
	frame.Parent = ContentArea
	Tabs[name] = frame
	return frame
end

local MainMenuTab = createTabFrame("MainMenu")
local ScriptsTab = createTabFrame("Scripts")
local EssentialsTab = createTabFrame("Essentials")
local OtherTab = createTabFrame("Other")

MainMenuTab.Visible = true

local function switchTab(tabName)
	for name, frame in pairs(Tabs) do
		frame.Visible = (name == tabName)
	end
end

