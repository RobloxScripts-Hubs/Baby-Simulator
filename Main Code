-- --- 4. TOGGLE BUILDER HELPER ---
local function createToggle(parentContainer, name, keyName, yPosition, callback)
	local btn = Instance.new("TextButton")
	btn.Name = name .. "Button"
	btn.Size = UDim2.new(1, -20, 0, 34)
	btn.Position = UDim2.new(0, 10, 0, yPosition)
	btn.BackgroundColor3 = Color3.fromRGB(32, 32, 38)
	btn.BorderSizePixel = 0
	btn.Text = name .. ": OFF"
	btn.Font = Enum.Font.GothamMedium
	btn.TextSize = 13
	btn.TextColor3 = Color3.fromRGB(180, 180, 180)
	btn.Parent = parentContainer

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 6)
	corner.Parent = btn

	local stroke = Instance.new("UIStroke")
	stroke.Color = Color3.fromRGB(50, 50, 58)
	stroke.Thickness = 1
	stroke.Parent = btn

	local function updateVisuals(activeState)
		if activeState then
			btn.BackgroundColor3 = Color3.fromRGB(16, 124, 65)
			btn.TextColor3 = Color3.fromRGB(255, 255, 255)
			btn.Text = name .. ": ON"
		else
			btn.BackgroundColor3 = Color3.fromRGB(32, 32, 38)
			btn.TextColor3 = Color3.fromRGB(180, 180, 180)
			btn.Text = name .. ": OFF"
		end
	end

	if savedToggles[keyName] then
		updateVisuals(true)
		task.defer(function()
			callback(true)
		end)
	end

	btn.MouseButton1Click:Connect(function()
		savedToggles[keyName] = not savedToggles[keyName]
		updateVisuals(savedToggles[keyName])
		callback(savedToggles[keyName])
	end)
end

