-- --- 5. MAIN TAB FEATURES ---

-- Auto Happiness (Fires remote event AND auto-equips "Baby Bottle" tool every 0.1s)
createToggle(mainContainer, "Auto Happiness", "AutoHappiness", 8, function(state)
	if state then
		task.spawn(function()
			while savedToggles.AutoHappiness do
				pcall(function()
					local event = ReplicatedStorage.Remotes:FindFirstChild("Input")
					if event then
						event:FireServer()
					end

					local char = player.Character
					local bp = player:FindFirstChild("Backpack")
					if char and bp then
						local bottle = bp:FindFirstChild("Baby Bottle") or char:FindFirstChild("Baby Bottle")
						local humanoid = char:FindFirstChildOfClass("Humanoid")
						if bottle and humanoid and bottle.Parent == bp then
							humanoid:EquipTool(bottle)
						end
					end
				end)
				task.wait(0.1)
			end
		end)
	end
end)

-- Auto Rebirth (Fires remote event and prevents screen blur without hiding any GUI elements)
createToggle(mainContainer, "Auto Rebirth", "AutoRebirth", 50, function(state)
	if state then
		task.spawn(function()
			while savedToggles.AutoRebirth do
				pcall(function()
					for _, child in ipairs(Lighting:GetChildren()) do
						if child:IsA("BlurEffect") then
							child.Enabled = false
						end
					end
					
					local rebirthEvent = ReplicatedStorage.Remotes:FindFirstChild("RequestRebirth")
					if rebirthEvent then
						rebirthEvent:InvokeServer()
					end
				end)
				task.wait(1)
			end
		end)
	end
end)

-- King - Farm Toggle (Perfect position lock + velocity zeroing to eliminate camera/character jitter)
createToggle(mainContainer, "King - Farm", "KingFarm", 92, function(state)
	if state then
		if kingFarmConnection then kingFarmConnection:Disconnect() end
		kingFarmConnection = RunService.RenderStepped:Connect(function()
			pcall(function()
				local char = player.Character
				if char then
					local rootPart = char:FindFirstChild("HumanoidRootPart")
					local humanoid = char:FindFirstChildOfClass("Humanoid")
					if rootPart then
						rootPart.CFrame = CFrame.new(1302, 496, -92)
						rootPart.AssemblyLinearVelocity = Vector3.zero
						rootPart.AssemblyAngularVelocity = Vector3.zero
					end
					if humanoid then
						humanoid.PlatformStand = true
					end
				end
			end)
		end)
	else
		if kingFarmConnection then
			kingFarmConnection:Disconnect()
			kingFarmConnection = nil
		end
		pcall(function()
			local char = player.Character
			if char then
				local humanoid = char:FindFirstChildOfClass("Humanoid")
				if humanoid then
					humanoid.PlatformStand = false
				end
			end
		end)
	end
end)


